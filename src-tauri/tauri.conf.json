{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CargoOptimizer",
  "version": "2.0.0",
  "identifier": "com.kaptanoguz.cargooptimizer",
  "build": {
    "frontendDist": "../dist-web",
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Cargo Optimizer Ada",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
